### list products
GET http://localhost:3001/products

### register
POST http://localhost:3001/auth/register
Content-Type: application/json

{ "email": "a@a.com", "password": "123456" }

### login (lấy token)
POST http://localhost:3001/auth/login
Content-Type: application/json

{ "email": "a@a.com", "password": "123456" }

> {% client.global.set("token", response.body.accessToken); %}

### login sai mat khau (mong doi 401)
POST http://localhost:3001/auth/login
Content-Type: application/json

{ "email": "a@a.com", "password": "sai12345" }

### register trung email (mong doi 409)
POST http://localhost:3001/auth/register
Content-Type: application/json

{ "email": "a@a.com", "password": "123456" }

### email sai dinh dang (mong doi 400)
POST http://localhost:3001/auth/register
Content-Type: application/json

{ "email": "abc", "password": "123456" }

### tao don (mong doi 201, status PENDING, total 90000)
POST http://localhost:3001/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{ "items": [{ "productId": 1, "size": "M", "toppings": ["Kem"], "qty": 2 }] }

### gio hang rong (mong doi 400)
POST http://localhost:3001/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{ "items": [] }

### khong co token (mong doi 401)
POST http://localhost:3001/orders
Content-Type: application/json

{ "items": [{ "productId": 1, "size": "M", "qty": 1 }] }
### thanh toan thanh cong (mong doi orderStatus PAID)
POST http://localhost:3001/payments
Authorization: Bearer {{token}}
Idempotency-Key: key-test-001
Content-Type: application/json

{ "orderId": 1, "method": "WALLET" }

### thanh toan loi (mong doi PAYMENT_FAILED)
POST http://localhost:3001/payments
Authorization: Bearer {{token}}
Idempotency-Key: key-test-002
Content-Type: application/json

{ "orderId": 2, "method": "CARD", "simulateFail": true }

